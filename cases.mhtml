if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>, 482 U.S. 22=
0,
228, 107 S. Ct. 2332, 96 L. Ed. 2d 185 (1987))</span></i></a><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>.
The sale of securities conditioned on the buyer's complete release of the
seller would in effect license non-compliance with the securities laws, in
violation of </span><a
href=3D"https://plus.lexis.com/api/document?collection=3Dstatutes-legislati=
on&amp;id=3Durn:contentItem:8S9D-W4W2-8T6X-702K-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>&sect; 29(a)<=
/span></i></a><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>.</span></p>

<p class=3DNormal10 style=3D'margin-top:12.0pt;text-align:justify;line-heig=
ht:15.0pt'><a
name=3D"Bookmark_I4XVMGKFRKD000YV8YK0000R"></a><a
name=3D"Bookmark_I5P67J7K2SF84V0050000400"></a><a name=3D"Bookmark_LNHNREFc=
lscc12_7"></a><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>A
release signed in the context of negotiations to settle an alleged securiti=
es
violation cannot be said to &quot;waive compliance&quot; with the securities
laws; the aggrieved party receives an agreed remedy for an alleged securiti=
es
violation, and that remedy satisfies &quot;compliance&quot; with the securi=
ties
laws. &quot;The federal securities laws do not compel persons harmed by acts
violating provisions of the laws to seek their remedies only through
litigation.&quot; </span><a name=3D"Bookmark_I5P67J7K2SF84V0040000400"></a>=
<a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4W-Y3M0-0039-X10H-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>Murtagh v. Un=
iv.
Computing Co.</span></i></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4W-Y3M0-0039-X10H-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>, 490 F.2d 81=
0,
816 (5th Cir. 1974)</span></i></a><span style=3D'font-family:"Times",serif;
mso-fareast-font-family:Times;color:black'>; <u>see also</u> <i
style=3D'mso-bidi-font-style:normal'>Construction and application of . . . =
</i></span><a
href=3D"https://plus.lexis.com/api/document?collection=3Dstatutes-legislati=
on&amp;id=3Durn:contentItem:8S9D-W4W2-8T6X-702K-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>&sect; 29(a)<=
/span></i></a><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:black'> of Securities Exchange Act of 1=
934</span></i><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>, </span><a
href=3D"https://plus.lexis.com/api/document?collection=3Danalytical-materia=
ls&amp;id=3Durn:contentItem:5PBG-NM40-01WH-54P7-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>26 A.L.R. Fed.
495</span></i></a><span style=3D'font-family:"Times",serif;mso-fareast-font=
-family:
Times;color:black'> (quotation set out in the margin</span><a style=3D'mso-=
footnote-id:
ftn143' href=3D"#_ftn143" name=3D"_ftnref143" title=3D""><sup><span style=
=3D'font-family:
"Times",serif;mso-fareast-font-family:Times'>7</span></sup></a><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>).
Under the same analysis, a release signed outside a settlement context migh=
t be
enforceable because the releasor would essentially be using an alleged
securities violation as a bargaining chip to receive some remedial benefit.=
 In
short, as a general &nbsp;[*173]&nbsp; principle, whenever a party offers
consideration to another in order to remedy an alleged violation of the
securities laws, acceptance of that offer in exchange for a&nbsp;[**21]&nbs=
p;
release of securities-fraud claims is tantamount to establishing
&quot;compliance&quot; with the securities laws. Such contracts do not run
afoul of </span><a
href=3D"https://plus.lexis.com/api/document?collection=3Dstatutes-legislati=
on&amp;id=3Durn:contentItem:8S9D-W4W2-8T6X-702K-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>&sect; 29(a)<=
/span></i></a><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>.</span></p>

<p class=3DNormal10 style=3D'margin-top:10.0pt;text-align:justify;line-heig=
ht:15.0pt'><a
name=3D"Bookmark_I5P67J7K2N1R5M0020000400"></a><span style=3D'font-family:"=
Times",serif;
mso-fareast-font-family:Times;color:black'>There may be exceptions to this
general rule. We have suggested that a release of securities-fraud claims in
settlement negotiation is valid only when &quot;signed in a commercial cont=
ext
by parties in a roughly equivalent bargaining position and with ready acces=
s to
counsel.&quot; </span><a name=3D"Bookmark_I5P67J7K2N1R5M0010000400"></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-0H50-0039-M1P2-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>Locafrance</s=
pan></i></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-0H50-0039-M1P2-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>, 558 F.2d at
1115</span></i></a><span style=3D'font-family:"Times",serif;mso-fareast-fon=
t-family:
Times;color:black'>; <u>see also </u></span><a
name=3D"Bookmark_I5P67J7K2N1R5M0030000400"></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-1GJ0-006F-M1XC-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>Harsco</span>=
</i></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-1GJ0-006F-M1XC-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>, 91 F.3d at =
344</span></i></a><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>
(upholding non-reliance clause after determining that both parties &quot;we=
re
sophisticated business entities negotiating&nbsp;[**22]&nbsp; at arm's
length&quot;). But we need not explore the parameters of this rule because,=
 as
explained below, it is clear that Kocourek 's execution of the Release Clau=
se
had nothing to do with satisfaction of a pre-existing securities claim.</sp=
an><a
style=3D'mso-footnote-id:ftn144' href=3D"#_ftn144" name=3D"_ftnref144" titl=
e=3D""><sup><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times'>8</span><=
/sup></a></p>

<p class=3DNormal10 style=3D'margin-top:10.0pt;text-align:justify;line-heig=
ht:15.0pt'><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>Booz
Allen points out that, before Kocourek signed the Letter, he had retained
counsel and threatened to sue Booz Allen over a dispute involving its shadow
stock program (a counterpart of the SRP for officers working abroad), and t=
hat
within five days of signing the Letter, Kocourek filed suit on those claims=
 in
New York state court.</span></p>

<p class=3DNormal10 style=3D'margin-top:10.0pt;text-align:justify;line-heig=
ht:15.0pt'><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>However,
although the Release Clause may have ended that litigation, it is clear that
that litigation had no influence or bearing on the applicability of the Rel=
ease
Clause here.</span><a style=3D'mso-footnote-id:ftn145' href=3D"#_ftn145"
name=3D"_ftnref145" title=3D""><sup><span style=3D'font-family:"Times",seri=
f;
mso-fareast-font-family:Times'>9</span></sup></a><span style=3D'font-family=
:"Times",serif;
mso-fareast-font-family:Times;color:black'> Booz Allen sent the Letter to <i
style=3D'mso-bidi-font-style:normal'>all</i> eligible shareholders; each
shareholder was required to sign the Release Clause before taking a payout =
for
the Carlyle Transaction; and the amount of each payout depended solely on t=
he
number of shares held. In short, though Kocourek received $20 million by
signing the Letter and selling his shares, no part of the transaction
constituted consideration (in whole or part) for a securities claim.</span>=
</p>

<p class=3DNormal10 style=3D'margin-top:10.0pt;text-align:justify;line-heig=
ht:15.0pt'><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>Consequently,
the Release Clause is voided by </span><a
href=3D"https://plus.lexis.com/api/document?collection=3Dstatutes-legislati=
on&amp;id=3Durn:contentItem:8S9D-W4W2-8T6X-702K-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>&sect; 29(a)<=
/span></i></a><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'> to
the extent it purports to release Kocourek's securities fraud&nbsp;[**23]&n=
bsp;
claims.</span></p>

<p class=3DNormal10 style=3D'margin-top:12.0pt;text-align:justify;line-heig=
ht:15.0pt'><a
name=3D"Bookmark_I4XVMGKFWDJ000YV8YK0000S"></a><a
name=3D"Bookmark_I5P67J7K2D6N320050000400"></a><span style=3D'font-family:"=
Times",serif;
mso-fareast-font-family:Times;color:black'>Although the Release Clause does=
 not
bar Kocourek's securities-fraud claims, it does prevent him from asserting =
his
common law and RICO claims. <u>Harsco</u> observed that the plaintiff's &qu=
ot;</span><a
href=3D"https://plus.lexis.com/api/document?collection=3Dstatutes-legislati=
on&amp;id=3Durn:contentItem:8S9D-W4W2-8T6X-702K-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>&sect; 29</sp=
an></i></a><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>
argument, if successful, would only warrant reversal on the federal securit=
ies
fraud claims. </span><a name=3D"Bookmark_LNHNREFclscc13_6"></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dstatutes-legislati=
on&amp;id=3Durn:contentItem:8S9D-W4W2-8T6X-702K-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>Section 29</s=
pan></i></a><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>'s
[e]ffect, if any, does not extend to the common law claims.&quot; </span><a
name=3D"Bookmark_I5P67J7K2D6N320040000400"></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-1GJ0-006F-M1XC-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>91 F.3d at 343
n.6</span></i></a><span style=3D'font-family:"Times",serif;mso-fareast-font=
-family:
Times;color:black'>. We therefore affirm the dismissal of Kocourek's common=
 law
claims.</span></p>

<p class=3DNormal10 style=3D'margin-top:10.0pt;text-align:justify;line-heig=
ht:15.0pt'><u><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>Harsco</span></u><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>
likewise mandates the dismissal of Kocourek's RICO claims. <a
name=3D"Bookmark_LNHNREFclscc14_6"></a>The RICO statute, as amended by the =
PSLRA,
states that &quot;no person may rely upon any conduct that would have been
actionable as fraud in the purchase or sale of securities to establish [RICO
liability].&quot; </span><a
href=3D"https://plus.lexis.com/api/document?collection=3Dstatutes-legislati=
on&amp;id=3Durn:contentItem:8SG9-5042-D6RV-H0PX-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>18 U.S.C. &se=
ct;
1964(c)</span></i></a><span style=3D'font-family:"Times",serif;mso-fareast-=
font-family:
Times;color:black'>. Kocourek therefore attempts to &nbsp;[*174]&nbsp; prem=
ise
RICO liability on predicate acts that do not sound in securities fraud. But=
 the
Release Clause categorically effected waiver of all claims other than
securities fraud. The combined effect of the PSLRA and Kocourek's execution=
 of
the Release Clause forecloses his RICO claims.</span></p>

