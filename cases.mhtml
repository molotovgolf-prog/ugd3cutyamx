if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>, 788 F.2d 18=
4,
188-89 (3d Cir. 1986)</span></i></a><span style=3D'font-family:"Times",seri=
f;
mso-fareast-font-family:Times;color:black'>. <a
name=3D"Bookmark_I4FJ6B470K1MNJ0GV0000400"></a>These courts have reasoned t=
hat: </span></p>

<p class=3DNormal12 style=3D'margin-top:10.0pt;margin-right:0in;margin-bott=
om:0in;
margin-left:20.0pt;margin-bottom:.0001pt;text-align:justify;line-height:15.=
0pt'><a
name=3D"Bookmark_I4FJ6B470K1MNJ0GV0000400_2"></a><a
name=3D"Bookmark_I4FJ6B470K1MNJ0GS0000400_2"></a><a
name=3D"Bookmark_I4FJ6B470K1MNJ0GJ0000400_2"></a><span style=3D'font-family=
:"Times",serif;
mso-fareast-font-family:Times;color:black'>While a scheme to defraud furthe=
red
by separate mailings may properly be viewed as one unitary offense, the los=
ses
which resulted therefrom must be separately identified as those which occur=
red
before and those which occurred after January 1, 1983 for purposes of
restitution&nbsp;[**42]&nbsp; under the . . . Act.</span></p>

<p class=3DNormal12 style=3D'text-align:justify;line-height:15.0pt'><a
name=3D"Bookmark_I4FJ6B470K1MNJ0GV0000400_3"></a><a
name=3D"Bookmark_I4FJ6B470K1MNJ0GS0000400_3"></a><span style=3D'font-family=
:"Times",serif;
mso-fareast-font-family:Times;color:black'><span
style=3D'mso-spacerun:yes'>&nbsp;</span></span></p>

<p class=3DNormal12><o:p>&nbsp;</o:p></p>

<p class=3DNormal12 style=3D'margin-top:12.0pt;text-align:justify;line-heig=
ht:15.0pt'><a
name=3D"Bookmark_I4FJ6B470K1MNJ0GR0000400"></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-7020-0039-P4RH-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>Martin</span>=
</i></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-7020-0039-P4RH-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>, 788 F.2d at=
 189</span></i></a><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>
(footnote omitted). In addition, the fifth circuit concluded that, because =
the
Act increased the possible punishment faced by a defendant by permitting an
order of restitution that was not a condition of probation, the Act's
application &quot;to acts committed before its effective date raises a prob=
lem
under the clause of the Constitution forbidding Congress to pass '<i
style=3D'mso-bidi-font-style:normal'>ex post facto</i> Law[s]'.&quot; </spa=
n><a
name=3D"Bookmark_I4FJ6B470K1MNJ0GT0000400"></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-3FV0-001B-K164-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>Corn</span></=
i></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-3FV0-001B-K164-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>, 836 F.2d at
895-96</span></i></a><span style=3D'font-family:"Times",serif;mso-fareast-f=
ont-family:
Times;color:black'> (footnote omitted). </span></p>

<p class=3DNormal12 style=3D'margin-top:10.0pt;text-align:justify;line-heig=
ht:15.0pt'><a
name=3D"Bookmark_I1KHVY49JHT000PRNKG000JP"></a><a
name=3D"Bookmark_I1KHVY49PBY000PRNKG000JR"></a><a
name=3D"Bookmark_I1KHVY49V63000PRNKG000JS"></a><a
name=3D"Bookmark_I4FJ6B470K1MNJ0GX0000400"></a><span style=3D'font-family:"=
Times",serif;
mso-fareast-font-family:Times;color:black'>Three other circuits have reached
the opposite conclusion, finding that <a name=3D"Bookmark_LNHNREFclscc10_9"=
></a>restitution
may be ordered for any act committed as part of a conspiracy if at least one
offense occurred after the Act's effective date.<span
style=3D'mso-spacerun:yes'>&nbsp; </span></span><a
name=3D"Bookmark_I4FJ6B470K1MNJ0GW0000400"></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4W-XVJ0-001B-K4S0-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>United States=
 v.
Angelica</span></i></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4W-XVJ0-001B-K4S0-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>, 859 F.2d 13=
90,
1392-93 (9th Cir. 1988)</span></i></a><span style=3D'font-family:"Times",se=
rif;
mso-fareast-font-family:Times;color:black'>; </span><a
name=3D"Bookmark_I4FJ6B470K1MNJ0GY0000400"></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-8TW0-001B-K1KJ-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>United States=
 v.
Purther</span></i></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-8TW0-001B-K1KJ-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>, 823 F.2d 96=
5,
968 (6th Cir. 1987)</span></i></a><span style=3D'font-family:"Times",serif;
mso-fareast-font-family:Times;color:black'>; </span><a
name=3D"Bookmark_I4FJ6B470K1MNJ0H10000400"></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-0680-0039-P4V7-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>United States=
 v.
Barnette</span></i></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-0680-0039-P4V7-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>, 800 F.2d 15=
58,
1570-71 (11th Cir. 1986)</span></i></a><span style=3D'font-family:"Times",s=
erif;
mso-fareast-font-family:Times;color:black'> (per curiam), <i style=3D'mso-b=
idi-font-style:
normal'>cert. denied</i>, <a name=3D"Bookmark_I4FJ6B470K1MNJ0H30000400"></a=
><i
style=3D'mso-bidi-font-style:normal'>480 U.S. 935, 94 L. Ed. 2d 769, 107 S.=
 Ct.
1578 (1987)</i>. <i style=3D'mso-bidi-font-style:normal'>Purther</i>&nbsp;[=
**43]&nbsp;
emphasized that the Act refers to the victim of an &quot;offense&quot; and
concluded the offense may be a mail fraud scheme, which can include acts
committed before January 1, 1983. The court held that the date of the victi=
m's
loss was relevant for determining its value, but not as to whether it could=
 be
the subject of an order of restitution. </span></p>

<p class=3DNormal12 style=3D'margin-top:10.0pt;text-align:justify;line-heig=
ht:15.0pt'><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>We
are persuaded by the decisions in <i style=3D'mso-bidi-font-style:normal'>A=
ngelica,
Purther</i>, and <i style=3D'mso-bidi-font-style:normal'>Barnette</i>. The =
Act
provides for restitution as a part of sentencing for an offense. In this ca=
se,
the offenses for which the defendants were sentenced include conspiracy to
conduct the affairs of an enterprise through a pattern of racketeering and
actual participation in a racketeering enterprise. Because the conspiracy a=
nd
enterprise extended into 1983, any loss sustained as a result of one of the
predicate acts underlying the RICO offenses seems to us to fall within the
scope of the Act. A contrary ruling would improperly treat the predicate ac=
ts,
rather than the RICO counts, as the offenses for which the defendants were
being sentenced. </span></p>

<p class=3DNormal12 style=3D'margin-top:10.0pt;text-align:justify;line-heig=
ht:15.0pt'><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>&nbsp;[*43]&nbsp;
The defendants also challenge the order of restitution on the ground that no
findings of fact were made at sentencing in support of the&nbsp;[**44]&nbsp;
award of restitution. Defendants contend that there was no showing that they
caused FCIP damage of $ 10,450: &quot;That Braz may have submitted an invoi=
ce
to show $ 10,450 worth of sheepskin coats were in his store on February 1, =
1980
does not mean that he claimed all of those goods were stolen.&quot; </span>=
<a
style=3D'mso-footnote-id:ftn245' href=3D"#_ftn245" name=3D"_ftnref245" titl=
e=3D""><sup><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times'>17</span>=
</sup></a><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>
However, we find that the government's proof that the federal government pa=
id
the defendants' claim is sufficient proof of the loss. Moreover, as the
government notes, there is a serious question whether the defendants, by
raising this argument for the first time on appeal, have waived it. </span>=
</p>

<p class=3DNormal12 style=3D'margin-top:12.0pt;text-align:justify;line-heig=
ht:15.0pt'><a
name=3D"Bookmark_I1KHVY4B18Y000PRNKG000JT"></a><a
name=3D"Bookmark_I4FJ6B470K1MNJ0H60000400"></a><span style=3D'font-family:"=
Times",serif;
mso-fareast-font-family:Times;color:black'>Finally, Braz's argument that the
trial court abused its discretion by lengthening his sentence (from that gi=
ven
after the first trial) based on its finding of perjury, but without a heari=
ng,
is not persuasive in light of </span><a name=3D"Bookmark_I4FJ6B470K1MNJ0H50=
000400"></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-8R20-003B-S1C4-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>United States=
 v.
Grayson</span></i></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-8R20-003B-S1C4-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>, 438 U.S. 41=
, 57
L. Ed. 2d 582, 98 S. Ct. 2610 (1978)</span></i></a><span style=3D'font-fami=
ly:
"Times",serif;mso-fareast-font-family:Times;color:black'>. <a
name=3D"Bookmark_I4FJ6B470K1MNJ0H80000400"></a>In <i style=3D'mso-bidi-font=
-style:
normal'>Grayson</i>, the Court held that &nbsp;[**45]&nbsp; <a
name=3D"Bookmark_LNHNREFclscc11_8"></a>a trial judge could include as a fac=
tor in
sentencing his or her conclusion that a defendant's testimony was perjured.=
 In
so holding, the Court rejected an argument, virtually indistinguishable from
the one presented by Braz, that consideration of the perjury in sentencing
would deprive the defendant of due process, because the enhanced sentence w=
ould
in effect constitute punishment for perjury without the protection of an
indictment, trial, and conviction and would chill the defendant's exercise =
of
his or her right to testify. <a name=3D"Bookmark_I4FJ6B470K1MNJ0H80000400_2=
"></a>Moreover,
the sentence was reinstated, although the statements of facts in neither the
decision of the Supreme Court nor the court of appeals, </span><a
name=3D"Bookmark_I4FJ6B470K1MNJ0H70000400"></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-1JT0-0039-M293-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>United States=
 v.
Grayson</span></i></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-1JT0-0039-M293-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>, 550 F.2d 10=
3,
107 (3d Cir. 1976)</span></i></a><span style=3D'font-family:"Times",serif;
mso-fareast-font-family:Times;color:black'>, indicate that a hearing addres=
sing
the finding of perjury was held or required. </span></p>

<p class=3DNormal12 style=3D'margin-top:12.0pt;text-align:justify;line-heig=
ht:15.0pt'><a
name=3D"Bookmark_I4FJ6B470K1MNJ0HB0000400"></a><span style=3D'font-family:"=
Times",serif;
mso-fareast-font-family:Times;color:black'>We do not agree with Braz's argu=
ment
that a district court's consideration at sentencing of perjury committed du=
ring
trial requires the same due process protection as does consideration of a
disputed item in a presentence report. A presentence report, unlike evidence
introduced at trial, often includes hearsay&nbsp;[**46]&nbsp; as to which t=
he
defendant may have the right to demand a hearing.<span
style=3D'mso-spacerun:yes'>&nbsp; </span></span><a
name=3D"Bookmark_I4FJ6B470K1MNJ0H90000400"></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-88R0-001B-K061-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>United States=
 v.
Romano</span></i></a><a
href=3D"https://plus.lexis.com/api/document?collection=3Dcases&amp;id=3Durn=
:contentItem:3S4X-88R0-001B-K061-00000-00&amp;context=3D"><i
style=3D'mso-bidi-font-style:normal'><span style=3D'font-family:"Times",ser=
if;
mso-fareast-font-family:Times;color:#0077CC;background:white'>, 825 F.2d 72=
5,
728-30 (2d Cir. 1987)</span></i></a><span style=3D'font-family:"Times",seri=
f;
mso-fareast-font-family:Times;color:black'> (holding that defendant must be
given an opportunity to dispute accuracy of information contained in a
presentence report, but due process does not require that the defendant be
allowed to do so at a hearing). However, a sentencing judge's determination
that the defendant committed perjury while on the stand is premised on pers=
onal
observation that satisfies the indicia of reliability required by the Feder=
al
Rules of Evidence and that is subject to the court's observation and the
defendant's control. Accordingly, we find that the district court did not e=
rr
in declining to hold an evidentiary hearing concerning its finding that Bra=
z,
in testifying, had committed perjury. </span></p>

<p class=3DNormal12 style=3D'margin-top:10.0pt;text-align:justify;line-heig=
ht:15.0pt'><span
style=3D'font-family:"Times",serif;mso-fareast-font-family:Times;color:blac=
k'>* *
* </span></p>

